#!/usr/bin/env python3
"""
terbibli — versículos bíblicos no terminal (Termu Linux)

Uso:
    terbibli                       → versículo aleatório (Almeida Atualizada)
    terbibli --versao acf          → usa outra versão da Bíblia
    terbibli --versoes             → lista as versões disponíveis
    terbibli --dia                 → versículo fixo do dia
    terbibli --buscar amor         → busca por palavra-chave
    terbibli --tema alegria        → busca por tema predefinido
    terbibli --total               → quantidade de versículos na Bíblia
    terbibli --info                → informações sobre o cache local
    terbibli --visual              → abre leitor visual da Bíblia completa
    terbibli --dia --visual        → versículo do dia destacado no leitor visual
"""

import sys
import os

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import argparse
import biblia
import display


def main():
    parser = argparse.ArgumentParser(
        prog="terbibli",
        description="Termu Linux — versículos bíblicos no terminal."
    )
    grupo = parser.add_mutually_exclusive_group()
    grupo.add_argument("--dia",    action="store_true", help="Versículo fixo do dia")
    grupo.add_argument("--buscar", metavar="TERMO",     help="Busca por palavra-chave")
    grupo.add_argument("--tema",   metavar="TEMA",      help="Busca por tema (ex: alegria, tristeza, obediência)")
    grupo.add_argument("--total",  action="store_true", help="Total de versículos na Bíblia")
    parser.add_argument("--versao",  metavar="VERSAO",  default=biblia.VERSAO_PADRAO,
                        help=f"Versão da Bíblia (padrão: {biblia.VERSAO_PADRAO}). Use --versoes para listar.")
    parser.add_argument("--versoes", action="store_true", help="Lista as versões disponíveis para download")
    parser.add_argument("--visual",  action="store_true", help="Abre o leitor visual da Bíblia")
    parser.add_argument("--temas",   action="store_true", help="Lista os temas disponíveis")
    parser.add_argument("--info",    action="store_true", help="Informações sobre o cache local da Bíblia")

    args = parser.parse_args()

    if args.versoes:
        print(f"\n\033[1m\033[36mVersões disponíveis:\033[0m\n")
        for codigo, nome in biblia.VERSOES.items():
            cached = " \033[32m[em cache]\033[0m" if biblia._cache_path(codigo).exists() else ""
            padrao = " \033[33m(padrão)\033[0m" if codigo == biblia.VERSAO_PADRAO else ""
            print(f"  \033[33m{codigo:<6}\033[0m {nome}{padrao}{cached}")
        print()
        return

    if args.temas:
        print(f"\n\033[1m\033[36mTemas disponíveis:\033[0m\n")
        for nome, palavras in biblia.TEMAS.items():
            print(f"  \033[33m{nome:<16}\033[0m → {', '.join(palavras[:3])}{'...' if len(palavras) > 3 else ''}")
        print()
        return

    versao = args.versao.strip().lower()
    if versao not in biblia.VERSOES:
        versoes_str = ", ".join(biblia.VERSOES.keys())
        parser.error(f"Versão desconhecida: '{versao}'. Use --versoes para ver as opções.")

    if args.info:
        info = biblia.info_cache(versao)
        if info is None:
            print(f"\nCache não encontrado para '{versao}'. Execute terbibli --versao {versao} para baixar.\n")
        else:
            print(f"\n\033[1m\033[36mCache da Bíblia\033[0m")
            print(f"  Versão     : {info['nome']} ({info['versao']})")
            print(f"  Versículos : {info['total_versos']:,}")
            print(f"  Tamanho    : {info['tamanho_mb']:.1f} MB")
            print(f"  Atualizado : {info['atualizado']}")
            print(f"  Fonte      : {info['fonte']}\n")
        return

    if args.buscar is not None:
        termo = args.buscar.strip()
        if not termo:
            parser.error("O termo de busca não pode ser vazio.")
        if len(termo) > 100:
            parser.error("O termo de busca deve ter no máximo 100 caracteres.")
        if not all(c.isalnum() or c.isspace() or c in "áéíóúãõâêôàçÁÉÍÓÚÃÕÂÊÔÀÇ'-():.,;" for c in termo):
            parser.error("O termo contém caracteres inválidos. Use apenas letras, números e símbolos básicos.")
        args.buscar = termo

    if args.tema is not None:
        tema = args.tema.strip().lower()
        if tema not in biblia.TEMAS:
            temas_str = ", ".join(biblia.TEMAS.keys())
            parser.error(f"Tema desconhecido. Temas disponíveis: {temas_str}")
        args.tema = tema

    try:
        dados = biblia.carregar(versao)
    except Exception as e:
        print(f"Erro ao carregar a Bíblia: {e}")
        return

    referencia = None

    if args.dia:
        ref, texto = biblia.do_dia(dados)
        display.exibir(ref, texto, titulo="Versículo do Dia")
        referencia = ref

    elif args.buscar:
        resultados = biblia.buscar(dados, args.buscar)
        display.listar_resultados(resultados)

    elif args.tema:
        resultados = biblia.buscar_tema(dados, args.tema)
        nome_tema = args.tema.capitalize()
        display.listar_resultados(resultados, titulo_prefixo=f"[{nome_tema}]")

    elif args.total:
        total = sum(
            len(cap) for livro in dados for cap in livro["chapters"]
        )
        print(f"\nTotal de versículos na Bíblia: {total:,}\n")

    else:
        ref, texto = biblia.aleatorio(dados)
        display.exibir(ref, texto, titulo="Versículo Aleatório")
        referencia = ref

    if args.visual:
        import biblia_visual
        biblia_visual.run(dados, referencia)


if __name__ == "__main__":
    main()
